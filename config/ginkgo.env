# =============================================================
# ginkgo (Redmi Note 8) —— 小米官方源码 + Droidspaces
# 纯净版：KSU_VARIANT=none，不集成任何 root 方案
#
# 用法：Actions → Build Kernel → Config file to build =
#       config/ginkgo.env
#
# 设备：Redmi Note 8 / ginkgo / 骁龙665(SM6125/trinket)
#       MIUI 12.5.5.0(RCOCNXM) / Android 11 / 原厂内核 4.14.190
# =============================================================

CONFIG_ENV=config/ginkgo.env

# ---------------------------------------------------- 内核源码 ----------
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=ginkgo-q-oss
KERNEL_CONFIG=vendor/ginkgo-perf_defconfig
# 小米公开源码里没有 ginkgo 的设备树，所以编出来的是 Image.gz（不带 DTB）。
# DTB 由下面的 BUILD_BOOT_IMG 从原厂 boot.img 里沿用。
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
# 留空 → 从 KERNEL_CONFIG 推导出 ginkgo，且不改 CONFIG_LOCALVERSION
KERNEL_NAME=

# ---------------------------------------------------- 工具链 ------------
# 上游注释原话：Newer clang frequently fails on 4.x trees (dropped flags,
# stricter warnings). r450784e is the safe choice for 4.9-4.19.
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
# 4.x 不能用纯 LLVM（会坏），用 clang 编译 + GNU binutils
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
# 内核的 $(AR) rcSTP 等 GNU 专有用法需要 ld.lld 之外的配合，上游用这个组合
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ---------------------------------------------------- Root -------------
# none = 不集成 root，纯编译内核（用户要的纯净版）
KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=auto
ENABLE_KPM=false
ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false

# ---------------------------------------------------- Kconfig ----------
# Droidspaces 需要 overlayfs
ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
# 4.14.117 是 2019 年的代码，现代编译器会报一堆警告；别让警告变错误
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# ---------------------------------------------------- Droidspaces ------
# 核心开关：自动应用 Droidspaces 补丁并配置容器所需内核选项
ENABLE_DROIDSPACES=true

# ---------------------------------------------------- 绕过 VINTF --------
# Android 会拿 /proc/config.gz 跟设备兼容性要求比对，不一致会报
# 「您的设备内部出现了问题，请联系您的制造商了解详情」。
# 开启后把【原厂配置】作为 /proc/config.gz 的数据源，绕过该校验。
ENABLE_STOCKCONFIG=true

# ---------------------------------------------------- 打包 -------------
NEED_DTBO=false

# 围绕原厂 boot.img 重打包：解包 → 只替换内核 → 用原厂参数重新打包，
# 于是【原厂 DTB 和 ramdisk 自动保留】—— 这正是小米源码缺 ginkgo 设备树的解法。
# 需要 SOURCE_BOOT_IMAGE 填一个【原厂 boot.img 的直链】。
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ---------------------------------------------------- Runner -----------
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
